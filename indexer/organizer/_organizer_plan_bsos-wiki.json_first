{
  "hubs": [
    {
      "id": "hemorrhage_shock_resuscitation",
      "title": "Hemorrhage, Shock & Resuscitation",
      "description": "Experimental, clinical, and systems perspectives on hemorrhagic/hypovolemic shock, exsanguination, cardiovascular responses, resuscitation strategies, and irreversible shock."
    },
    {
      "id": "heart_ischemia_arrhythmias",
      "title": "Heart, Ischemia & Arrhythmias",
      "description": "Cardiac metabolism, ischemia\u2013reperfusion injury, contractility, and arrhythmia mechanisms from cell to whole heart in shock and non\u2011shock contexts."
    },
    {
      "id": "endothelium_microcirculation_organs",
      "title": "Endothelium, Microcirculation & Organ Injury",
      "description": "Endothelial biology, glycocalyx, microvascular flow, gut\u2013liver axis, organ ischemia, and multiple organ failure in shock and critical illness."
    },
    {
      "id": "models_monitoring_biomarkers",
      "title": "Models, Monitoring & Biomarkers",
      "description": "Animal and computational models of shock, hemodynamic monitoring, waveform analytics, and metabolic/biologic markers for diagnosis and triage."
    },
    {
      "id": "trauma_systems_clinical_care",
      "title": "Trauma Systems, Clinical Care & Epidemiology",
      "description": "Trauma systems, battlefield and civilian care, guidelines, epidemiology, complications, and outcome analyses in hemorrhagic shock and trauma."
    }
  ],
