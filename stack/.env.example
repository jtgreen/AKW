# Copy this file to `stack/.env` on the server (or let `setup_wiki_interactive.py` write it).
#
# Required
WIKI_NAME=my-wiki
DOMAIN=example.com
WIKI_BASE_URL=https://example.com
WIKI_DATA_DIR=/opt/my-wiki-data
POSTGRES_PASSWORD=change-me
OPENAI_API_KEY=sk-your-key

# Optional (currently unused by docker-compose, but useful for docs/scripts)
WIKI_PDFS_DIR=/opt/my-wiki-pdfs
