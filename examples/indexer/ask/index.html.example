<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{WIKI_NAME}} Wiki Assistant</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: #080b12;
      color: #eef2ff;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 2rem 1rem 4rem;
    }

    .app {
      width: min(900px, 100%);
      background: rgba(20, 25, 37, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
      padding: 2rem;
      backdrop-filter: blur(12px);
    }

    h1 {
      margin: 0 0 0.5rem;
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      letter-spacing: 0.02em;
    }

    p.subtitle {
      margin: 0 0 1.5rem;
      color: #94a3b8;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    textarea, select {
      width: 100%;
      background: rgba(13, 17, 23, 0.7);
      color: inherit;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 1rem;
      font-size: 1rem;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    button {
      align-self: flex-end;
      background: linear-gradient(135deg, #3b82f6, #06b6d4);
      color: white;
      border: none;
      border-radius: 999px;
      padding: 0.85rem 2rem;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    button:disabled {
      opacity: 0.6;
      cursor: progress;
    }

    button:not(:disabled):hover {
      transform: translateY(-1px);
    }

    .status {
      min-height: 1.5rem;
      font-size: 0.95rem;
      color: #93c5fd;
    }

    .card {
      margin-top: 2rem;
      padding: 1.5rem;
      border-radius: 16px;
      background: rgba(8, 11, 18, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    #answer-text {
      line-height: 1.5;
    }

    .sources {
      margin-top: 1.25rem;
    }

    .source-item {
      border-left: 3px solid #38bdf8;
      padding-left: 0.75rem;
      margin-bottom: 0.75rem;
      color: #cbd5f5;
      font-size: 0.95rem;
    }

    .source-item-title {
      font-weight: 600;
    }

    .source-links {
      margin-top: 0.35rem;
      font-size: 0.9rem;
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .source-links a {
      color: #8bd1ff;
      text-decoration: none;
    }

    .source-links a:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      .app {
        padding: 1.5rem;
      }
      textarea {
        min-height: 160px;
      }
      button {
        align-self: stretch;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <h1>{{WIKI_NAME}} Assistant</h1>
    <p class="subtitle">
      Grounded answers from your wiki + PDFs.
    </p>

    <form id="ask-form">
      <label for="query" style="font-weight:600;">Ask a question</label>
      <textarea
        id="query"
        name="query"
        placeholder="e.g. Summarize the key mechanism and cite sources."
        required
      ></textarea>
      <label for="model" style="font-weight:600;">Model</label>
      <select id="model" name="model">
        <option value="gpt-5.1">GPT-5.1 (default)</option>
        <option value="gpt-5.1-instant">GPT-5.1 Instant</option>
        <option value="gpt-5.1-mini">GPT-5.1 Mini</option>
        <option value="gpt-4.1">GPT-4.1</option>
        <option value="gpt-4.1-mini">GPT-4.1 Mini</option>
      </select>
      <button type="submit">Ask</button>
      <div class="status" id="status"></div>
    </form>

    <div class="card" id="answer-card" style="display:none;">
      <h2>Answer</h2>
      <div id="answer-text"></div>
      <div class="sources" id="sources"></div>
    </div>
  </div>

  <script>
    const form = document.getElementById("ask-form");
    const queryInput = document.getElementById("query");
    const statusEl = document.getElementById("status");
    const answerCard = document.getElementById("answer-card");
    const answerText = document.getElementById("answer-text");
    const sourcesEl = document.getElementById("sources");
    const button = form.querySelector("button");
    const modelSelect = document.getElementById("model");
    const WIKI_BASE = `${window.location.origin.replace(/\\/+$/, "")}/`;
    const isInternalLink = (url = "") => url.startsWith("/") || url.startsWith(WIKI_BASE);

    async function askWiki(query, model) {
      const response = await fetch("/ask/api/ask", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, model }),
      });
      if (!response.ok) {
        const detail = await response.text();
        throw new Error(detail || response.statusText);
      }
      return response.json();
    }

    function renderSources(sources) {
      sourcesEl.innerHTML = "";
      if (!Array.isArray(sources) || !sources.length) {
        return;
      }
      const frag = document.createDocumentFragment();
      sources.forEach((source, idx) => {
        const div = document.createElement("div");
        div.className = "source-item";

        const title = document.createElement("div");
        title.className = "source-item-title";
        title.textContent = source.title || `Source ${idx + 1}`;
        div.appendChild(title);

        const linksRow = document.createElement("div");
        linksRow.className = "source-links";

        if (source.wiki_url && isInternalLink(source.wiki_url)) {
          const wikiLink = document.createElement("a");
          wikiLink.href = source.wiki_url;
          wikiLink.target = "_blank";
          wikiLink.rel = "noopener";
          wikiLink.textContent = "Wiki";
          linksRow.appendChild(wikiLink);
        }

        if (source.pdf_url && isInternalLink(source.pdf_url)) {
          const pdfLink = document.createElement("a");
          pdfLink.href = source.pdf_url;
          pdfLink.target = "_blank";
          pdfLink.rel = "noopener";
          pdfLink.textContent = "PDF";
          linksRow.appendChild(pdfLink);
        }

        if (linksRow.childNodes.length) {
          div.appendChild(linksRow);
        }
        frag.appendChild(div);
      });
      sourcesEl.appendChild(frag);
    }

    form.addEventListener("submit", async (evt) => {
      evt.preventDefault();
      const query = queryInput.value.trim();
      if (!query) {
        statusEl.textContent = "Enter a question first.";
        return;
      }

      button.disabled = true;
      statusEl.textContent = "Thinking...";
      answerCard.style.display = "none";

      try {
        const model = modelSelect.value;
        const data = await askWiki(query, model);
        const rawAnswer = data.answer?.trim() || "";
        const escaped = rawAnswer
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
        const withMarkdownLinks = escaped.replace(
          /\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g,
          (_match, label, url) =>
            isInternalLink(url)
              ? `<a href="${url}" target="_blank" rel="noopener">${label}</a>`
              : label
        );
        const linkified = withMarkdownLinks
          .replace(/(https?:\\/\\/[^\\s<)]+)/g, (match, _p1, offset, text) => {
            if (!isInternalLink(match)) {
              return match;
            }
            const preceding = text.slice(Math.max(0, offset - 7), offset);
            if (preceding.includes('href="') || preceding.includes("href='")) {
              return match;
            }
            return `<a href="${match}" target="_blank" rel="noopener">${match}</a>`;
          })
          .replace(/\\n/g, "<br>");
        answerText.innerHTML = linkified || "No answer returned.";
        renderSources(data.sources);

        answerCard.style.display = "block";
        statusEl.textContent = "Done.";
      } catch (err) {
        console.error(err);
        statusEl.textContent = `Error: ${err.message}`;
      } finally {
        button.disabled = false;
      }
    });
  </script>
</body>
</html>

