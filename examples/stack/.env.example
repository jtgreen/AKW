# Copy this file to `/opt/<wiki-name>-stack/.env` (or let `scripts/setup_wiki_interactive.py` write it).

WIKI_NAME=my-wiki
DOMAIN=example.com
WIKI_BASE_URL=https://example.com

WIKI_DATA_DIR=/opt/my-wiki-data
WIKI_REPO_ROOT=/opt/my-wiki-data/repo
WIKI_PDFS_DIR=/opt/my-wiki-pdfs
INDEXER_DIR=/opt/my-wiki-indexer

POSTGRES_PASSWORD=change-me
OPENAI_API_KEY=sk-your-key